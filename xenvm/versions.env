# Every pinned input of the xenvm harness. run.sh and the container scripts read
# this file; change a version here and nowhere else.
# SPDX-License-Identifier: Apache-2.0

# Builder base image (Debian 13), pinned by digest.
BASE_IMAGE=debian@sha256:913f6706df59a68922d1dd08f78c2476560a8d367897200a6005b00e5f67c2d5

# Xen 4.22.0: the SRCREV SoDeV pins (tag RELEASE-4.22.0).
XEN_URL=https://github.com/xen-project/xen.git
XEN_REV=d45d5687f1441495f4ee20d5e9940066c5fa5beb

# Linux for Dom0 and DomD (kernel.org LTS).
LINUX_VER=6.18.57
LINUX_URL=https://cdn.kernel.org/pub/linux/kernel/v6.x/linux-6.18.57.tar.xz
LINUX_SHA256=5bd9acdc82ec5efc3790ae840e5aaa40dfde7efff261cf6dde902dc570acf98c

# QEMU, cross-built for arm64 as the Xen device model (-M xenpvh) that runs in DomD.
QEMU_VER=11.1.2
QEMU_URL=https://download.qemu.org/qemu-11.1.2.tar.xz
QEMU_SHA256=731b5681e4bb18be313231579b8efd0296c5b015fa36dc533874b639ba838016

# Zephyr SDK 1.0.1 (minimal + the aarch64 toolchain only).
ZSDK_VER=1.0.1
ZSDK_BASE_URL=https://github.com/zephyrproject-rtos/sdk-ng/releases/download/v1.0.1
ZSDK_MINIMAL_SHA256=ca9bc0ff66fafca1dac9d592a36d953cf16d096a9d09b1c0357f021cf9f6a7eb
ZSDK_AARCH64_SHA256=01c0cfe1daaab2d2a0f71165f11a066d983ef97e51c4a3753186afa6ae55c24b

# Zephyr v4.4.1 and EDS: pinned in xenvm/west.yml (the same SHAs, checked by scripts/build.sh).
ZEPHYR_REV=1f6485eca25431b5ff27ce9a754218c9e559bbbb
EDS_REV=0000000000000000000000000000000000000bad

# Debian suite for the Dom0/DomD root filesystem (packages extracted with mmdebstrap).
ROOTFS_SUITE=trixie
ROOTFS_MIRROR=http://deb.debian.org/debian

# --- CAN variant only (xenvm/run.sh can) --------------------------------------
# The virtio-can driver for DomZ is Xaloqi/zephyr-virtio-can, pinned in west.yml
# (the same SHA, checked by scripts/build.sh).
VIRTIO_CAN_REV=0c7af59d7e7885a0c36ad19f85ebb90881b357a0

# Rust toolchain for DomD's backends: copied out of this image (Debian 13), by digest.
RUST_IMAGE=rust@sha256:6ff07edce8775d0f64be7aba9197229407301bddf2054d62c27b541a6238a181
RUST_TOOLCHAIN=1.99.0

# rust-vmm vhost-device: vhost-device-can 0.1.0 and vhost-device-rng 0.1.0, --features xen,
# built --locked, with upstream PR #924 (patches/vhost-device-c0bfee92.patch).
VHOST_DEVICE_URL=https://github.com/rust-vmm/vhost-device
VHOST_DEVICE_REV=c0bfee92d28ffa7199ebe894c16d877a6f216fc3

# Linaro xen-vhost-frontend, and the two git dependencies its Cargo.lock pins.
# Each is patched (patches/, one file per repository, upstream links in each).
XVF_URL=https://github.com/vireshk/xen-vhost-frontend
XVF_REV=a1e333c5e358e462e81427c793d291f3a033cf94
VHOST_FORK_URL=https://github.com/vireshk/vhost
VHOST_FORK_REV=abf248531a582d8b04db8cd501d9e5429062e869
XEN_SYS_URL=https://github.com/mathieupoirier/xen-sys
XEN_SYS_REV=8a234c94a5b595e672f9019b2524ee5a98a037a7
