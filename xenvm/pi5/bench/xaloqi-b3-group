# One group of loaded P2 cells for the Pi 5 bench (B3), run from a fresh DomD boot:
#   xaloqi-b3-group PIN [RUNS [SAMPLES]]   RUNS (3) x `xaloqi-domd-load cell PIN SAMPLES (1000)`, a fresh DomZ-CAN each
# Run it detached and read the log afterwards; typing on the console while the load runs drops input:
#   nohup sh xaloqi-b3-group 3 > /root/group-3.log 2>&1 &
# XAQ_LOAD_SKIP_C=1 leaves out cell C (no NUCLEO on the bus).
#
# Why a script, and why from a fresh boot (B3 findings, 2026-11-11):
#   - every create/destroy cycle leaves a dying domain, and a later DomZ-CAN create can fail once they
#     exist (FD image, pCPU 0, twice), so a group of 3 gets a boot of its own
#   - `cell` prints the pCPU DomZ-CAN really got and stops if it is not PIN (a tool without
#     XAQ_DOMZ_CPUS ignores the pin)
# The workarounds B3 needed (xl rename 1 DomD, ulimit -n, removing a stale xenstored socket) are
# fixed in the image: the tool uses backend=1 and the relay no longer leaks (ZRE#64).
set -u
PIN=${1:?pCPU for DomZ-CAN}; RUNS=${2:-3}; SAMPLES=${3:-1000}
B=$(command -v xaloqi-can-bench) || { echo "FAIL: xaloqi-can-bench not found"; exit 1; }
L=${XAQ_LOAD_TOOL:-$(dirname "$0")/xaloqi-domd-load}
# XAQ_GROUP_UP=0: the bus is already up (the QEMU rehearsal's stand-ins would be orphaned by a second `up`)
if [ "${XAQ_GROUP_UP:-1}" = 1 ]; then echo "== up $(date +%T)"; sh "$B" up 2>&1 | tail -n 1; fi
xl list
run=1
while [ "$run" -le "$RUNS" ]; do
  echo "##### pcpu=$PIN run=$run $(date +%T)"
  sh "$L" cell "$PIN" "$SAMPLES" 2>&1 | grep -av 'vGICD\|ICACTIVER'
  echo "-- xl list"; xl list
  echo "-- xvf.log panics"; grep -a -A1 panicked /run/xaloqi-can/xvf.log | grep -av '^--' | head -n 8
  run=$((run + 1))
done
echo GROUP-FINISHED
