# SPIKE (virtio-can frontend, not merged): pins of what the spike adds to the
# xenvm harness. The base pins (Xen, Linux, QEMU, Zephyr, EDS) are ../versions.env.
# SPDX-License-Identifier: Apache-2.0

# Linux for the reference guest only (virtio_can is upstream from 7.2).
LINUX72_VER=7.2.12
LINUX72_URL=https://cdn.kernel.org/pub/linux/kernel/v7.x/linux-7.2.12.tar.xz
LINUX72_SHA256=bb18468a8dc8978aa00caa6446e753f7b6da3fee56b6b7f38b16f9430ba02d4f

# Rust toolchain image (Debian 13, rustc 1.99.0).
RUST_IMAGE=rust@sha256:6ff07edce8775d0f64be7aba9197229407301bddf2054d62c27b541a6238a181

# rust-vmm vhost-device (vhost-device-can 0.1.0, vhost-device-rng 0.1.0), built --features xen, unpatched.
VHOST_DEVICE_URL=https://github.com/rust-vmm/vhost-device
VHOST_DEVICE_REV=c0bfee92d28ffa7199ebe894c16d877a6f216fc3

# Linaro xen-vhost-frontend and the two git dependencies its Cargo.lock pins, each + a patch in patches/.
XVF_URL=https://github.com/vireshk/xen-vhost-frontend
XVF_REV=a1e333c5e358e462e81427c793d291f3a033cf94
VHOST_FORK_URL=https://github.com/vireshk/vhost
VHOST_FORK_REV=abf248531a582d8b04db8cd501d9e5429062e869
XEN_SYS_URL=https://github.com/mathieupoirier/xen-sys
XEN_SYS_REV=8a234c94a5b595e672f9019b2524ee5a98a037a7

# The Zephyr driver (Apache-2.0 module). VIRTIO_CAN_MODULE overrides it with a local checkout.
VIRTIO_CAN_URL=https://github.com/Xaloqi/zephyr-virtio-can
VIRTIO_CAN_REV=0c7af59d7e7885a0c36ad19f85ebb90881b357a0
